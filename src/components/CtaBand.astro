---
import Arrow from './Arrow.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Have a project in mind?',
  body = 'Book a free 30-minute call. You will talk to a senior engineer, not a salesperson, and leave with an honest read on scope, cost, and next steps.',
} = Astro.props;
---

<section class="cta section--dark">
  <div class="cta__glow" aria-hidden="true"></div>
  <div class="container cta__inner" data-reveal>
    <h2 class="h2">{title} <span class="serif">Let’s talk.</span></h2>
    <p class="lede">{body}</p>
    <div class="cta__actions">
      <a href="/contact" class="btn btn--primary">Book a free call <Arrow /></a>
      <a href={`mailto:${site.email}`} class="btn btn--ghost">{site.email}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding: var(--section) 0;
    text-align: center;
  }
  .cta__glow {
    position: absolute;
    left: 50%;
    bottom: -60%;
    width: 900px;
    height: 600px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 38%, transparent), transparent);
    filter: blur(20px);
  }
  .cta__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 24px;
  }
  .cta h2 {
    max-width: 14ch;
  }
  .cta .serif {
    color: var(--accent);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
  }
</style>
