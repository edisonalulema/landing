---
import Logo from './Logo.astro';
import { nav, services, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer section--dark">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" aria-label="Algopop home"><Logo /></a>
        <p>{site.tagline}. We design, build, and run software for growing businesses across North America.</p>
        <a class="footer__email" href={`mailto:${site.email}`}>{site.email}</a>
      </div>

      <div class="footer__cols">
        <div>
          <h2>Services</h2>
          <ul>
            {services.map((s) => <li><a href={`/services#${s.slug}`}>{s.title}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>Company</h2>
          <ul>
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <h2>Elsewhere</h2>
          <ul>
            <li><a href={site.linkedin} rel="noopener" target="_blank">LinkedIn</a></li>
            <li><a href={`mailto:${site.email}`}>Email</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {year} Algopop. All rights reserved.</span>
      <span>Built in-house. Static, fast, and accessible.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 80px 0 32px;
    --logo-stroke: var(--dark);
  }

  .footer__top {
    display: grid;
    gap: 56px;
    padding-bottom: 56px;
    border-bottom: 1px solid var(--line);
  }

  .footer__brand {
    display: grid;
    gap: 18px;
    align-content: start;
    max-width: 380px;
  }

  .footer__brand p {
    color: var(--ink-2);
    font-size: 15.5px;
  }

  .footer__email {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
    width: fit-content;
    border-bottom: 1px solid var(--line-strong);
  }

  .footer__email:hover {
    border-color: var(--accent);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 24px;
  }

  .footer h2 {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 16px;
  }

  .footer ul {
    display: grid;
    gap: 10px;
    font-size: 15px;
  }

  .footer ul a {
    color: var(--ink-2);
    transition: color 0.2s;
  }

  .footer ul a:hover {
    color: var(--ink);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-top: 28px;
    font-size: 13.5px;
    color: var(--ink-3);
  }

  @media (min-width: 900px) {
    .footer__top {
      grid-template-columns: 1fr 1.4fr;
    }
    .footer__cols {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
