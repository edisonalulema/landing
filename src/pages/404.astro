---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---

<Base title="Page not found">
  <section class="nf">
    <div class="container nf__inner">
      <span class="eyebrow">404</span>
      <h1 class="display">This page <span class="serif">popped.</span></h1>
      <p class="lede">The link may be old or mistyped. Everything we do is one click away.</p>
      <div class="nf__actions">
        <a href="/" class="btn btn--primary">Back to home <Arrow /></a>
        <a href="/contact" class="btn btn--ghost">Contact us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding: clamp(80px, 14vw, 180px) 0;
  }
  .nf__inner {
    display: grid;
    gap: 24px;
  }
  .nf .serif {
    color: var(--accent);
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
