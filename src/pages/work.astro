---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { work } from '../data/site';
---

<Base
  title="Work"
  description="Case studies from Algopop: real-time voice AI, consumer mobile apps, Odoo ERP migrations, and full-stack web platforms."
>
  <PageHero
    eyebrow="Selected work"
    title="Problems solved,"
    accent="systems shipped."
    lede="A sample of recent engagements. We keep client names private by default; ask on a call and we’ll walk you through the details, the code, and the people involved."
  />

  <section class="section">
    <div class="container cases">
      {
        work.map((w, i) => (
          <article id={w.slug} class="case" data-reveal>
            <header class="case__head">
              <span class="case__index">{String(i + 1).padStart(2, '0')} / {String(work.length).padStart(2, '0')}</span>
              <span class="case__client">{w.client}</span>
              <h2 class="h3 case__title">{w.title}</h2>
              <div class="tags">
                {w.services.map((s) => <span class="tag tag--accent">{s}</span>)}
              </div>
            </header>

            <div class="case__body">
              <div class="case__grid">
                <section>
                  <h3>The problem</h3>
                  <p>{w.problem}</p>
                </section>
                <section>
                  <h3>What we built</h3>
                  <p>{w.approach}</p>
                </section>
              </div>
              <section class="case__outcome">
                <h3>Outcome</h3>
                <p>{w.outcome}</p>
              </section>
              <div class="case__foot">
                <ul class="checklist">
                  {w.highlights.map((h) => <li>{h}</li>)}
                </ul>
                <div class="tags">
                  {w.stack.map((t) => <span class="tag">{t}</span>)}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand title="Want results like these?" />
</Base>

<style>
  .cases {
    display: grid;
    gap: 24px;
  }
  .case {
    display: grid;
    gap: 36px;
    padding: clamp(28px, 4vw, 48px);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    border: 1px solid var(--line);
  }
  .case__head {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .case__index,
  .case__client {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .case__index {
    color: var(--accent);
  }
  .case__title {
    font-size: clamp(26px, 3vw, 36px);
    max-width: 20ch;
  }
  .tag--accent {
    background: var(--accent-soft);
    border-color: transparent;
    color: var(--ink);
  }
  .case__body {
    display: grid;
    gap: 28px;
  }
  .case__grid {
    display: grid;
    gap: 28px;
  }
  .case h3 {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 10px;
  }
  .case p {
    color: var(--ink-2);
  }
  .case__outcome {
    padding: 22px 24px;
    border-left: 3px solid var(--accent);
    background: var(--bg-sunken);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .case__outcome p {
    color: var(--ink);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .case__foot {
    display: grid;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 760px) {
    .case__grid,
    .case__foot {
      grid-template-columns: 1fr 1fr;
    }
    .case__foot .tags {
      align-content: start;
    }
  }
  @media (min-width: 1100px) {
    .case {
      grid-template-columns: 1fr 1.8fr;
      gap: 64px;
    }
  }
</style>
