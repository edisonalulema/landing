---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Arrow from '../components/Arrow.astro';
import { services } from '../data/site';
---

<Base
  title="Services"
  description="Custom software, AI integration, mobile apps, Odoo ERP, cloud and DevOps, and data automation, delivered by one senior engineering team."
>
  <PageHero
    eyebrow="Services"
    title="Everything it takes to ship,"
    accent="under one roof."
    lede="Six practices that cover the full lifecycle of a product: strategy and architecture, design and build, launch and operations. Pick one, or let us run the whole thing."
  >
    <nav class="jump" aria-label="Jump to service" data-reveal style="--delay: 180ms">
      {services.map((s) => <a href={`#${s.slug}`}>{s.title}</a>)}
    </nav>
  </PageHero>

  <section class="section">
    <div class="container list">
      {
        services.map((s, i) => (
          <article id={s.slug} class="svc" data-reveal>
            <div class="svc__head">
              <span class="svc__num">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="h2">{s.title}</h2>
              <p class="svc__pain">{s.pain}</p>
            </div>
            <div class="svc__body">
              <p class="lede">{s.summary}</p>
              <div class="svc__cols">
                <div>
                  <h3 class="svc__label">What you get</h3>
                  <ul class="checklist">
                    {s.deliverables.map((d) => <li>{d}</li>)}
                  </ul>
                </div>
                <div>
                  <h3 class="svc__label">Typical stack</h3>
                  <div class="tags">
                    {s.stack.map((t) => <span class="tag">{t}</span>)}
                  </div>
                </div>
              </div>
              <a href="/contact" class="link-arrow">Talk to us about {/^[A-Z][a-z]/.test(s.title) ? s.title[0].toLowerCase() + s.title.slice(1) : s.title} <Arrow /></a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand title="Not sure which one you need?" body="Most clients aren’t. Tell us the problem and we’ll tell you the shortest path to solving it, including when the answer is off-the-shelf software instead of us." />
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .jump a {
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--bg-raised);
    font-size: 14.5px;
    transition: border-color 0.2s, color 0.2s;
  }
  .jump a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .list {
    display: grid;
  }
  .svc {
    display: grid;
    gap: 32px;
    padding: clamp(48px, 6vw, 80px) 0;
    border-top: 1px solid var(--line);
  }
  .svc:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .svc__head {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .svc__num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
  }
  .svc__pain {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 24px;
    line-height: 1.25;
    color: var(--ink-2);
    max-width: 22ch;
  }
  .svc__body {
    display: grid;
    gap: 32px;
    align-content: start;
  }
  .svc__cols {
    display: grid;
    gap: 32px;
    padding: 28px;
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    border: 1px solid var(--line);
  }
  .svc__label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 16px;
  }
  .svc .link-arrow {
    width: fit-content;
  }
  @media (min-width: 760px) {
    .svc__cols {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  @media (min-width: 1040px) {
    .svc {
      grid-template-columns: 1fr 1.5fr;
      gap: 72px;
    }
    .svc__head {
      position: sticky;
      top: 110px;
    }
  }
</style>
